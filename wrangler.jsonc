{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-bip",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "36d3b612-da22-4593-8fd1-3a6f54bd4263","database_name": "web-app-bip" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ea9cdd6f986545a2be0a337c831a5715" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
